PulseOximeter pox;
uint32_t tsLastReport = 0; float spo2 = 0;
float heartRate = 0; float temp = 0;

//	Beat Callback void onBeatDetected() { Serial.println("Beat!");
digitalWrite(A1,!digitalRead(A1));
}

//	Setup
void setup() {
 
Serial.begin(9600); Wire.begin(); // IMPORTANT

Serial.println("Initializing Pulse Oximeter..."); pinMode(A0,INPUT); pinMode(A1,OUTPUT);

if (!pox.begin()) { Serial.println("FAILED"); while (1); // Stop here
} else { Serial.println("SUCCESS");
}

pox.setIRLedCurrent(MAX30100_LED_CURR_7_6MA); pox.setOnBeatDetectedCallback(onBeatDetected);
}
//	Loop
void loop() {

// Must be called continuously pox.update();

// Report every 1 sec
if (millis() - tsLastReport > REPORTING_PERIOD_MS) {

heartRate = pox.getHeartRate(); spo2 = pox.getSpO2();
temp = analogRead(A0) * 0.048875;

// Validate readings
if (heartRate > 30 && heartRate < 220) { Serial.print("HR:"); Serial.print(heartRate);
} else { Serial.print("HR:0");
}

Serial.print(",SPO2:");

if (spo2 > 70 && spo2 <= 100) { Serial.print(spo2);
 
} else { Serial.print("0");
}
Serial.print(",Temp:"); Serial.println(temp,2); tsLastReport = millis();
}


