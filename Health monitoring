//	Nano Data
void readNanoData() {
if (SharedUART.available()) {
String data = SharedUART.readStringUntil('\n'); Serial.print("Received: ");
Serial.println(data);
int hrIndex = data.indexOf("HR:"); int spIndex = data.indexOf("SPO2:"); int tIndex = data.indexOf("Temp:");
 
if (hrIndex != -1 && spIndex != -1 && tIndex != -1) {
heartRate = data.substring(hrIndex + 3, data.indexOf(",", hrIndex)).toInt(); spo2 = data.substring(spIndex + 5, data.indexOf(",", spIndex)).toInt(); nanoTemp = data.substring(tIndex + 5).toFloat();
nanoTemp = nanoTemp - 6; digitalWrite(LED_STATUS, HIGH); delay(80); digitalWrite(LED_STATUS, LOW);
Serial.print("Parsed -> HR: "); Serial.print(heartRate); Serial.print(" | SPO2: "); Serial.print(spo2); Serial.print(" | Temp: "); Serial.println(nanoTemp);
}
}
}
