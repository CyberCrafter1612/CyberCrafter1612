//	SMS
void sendSMS(float temp, float lat, float lng) {

Serial.println("SOS Triggered! Sending SMS..."); showSendingSMS();
SharedUART.println("AT"); delay(1000);

SharedUART.println("AT+CMGF=1"); delay(1000);
SharedUART.println("AT+CMGS=\"+919939333586\"");
delay(2000);
SharedUART.print("SOS ALERT!\n");

SharedUART.print("HR:"); SharedUART.print(heartRate);

SharedUART.print(" SPO2:"); SharedUART.print(spo2);

SharedUART.print("\nTemp:"); SharedUART.print(temp); SharedUART.print("C");

SharedUART.print("\nLoc:"); SharedUART.print(lat, 6); SharedUART.print(","); SharedUART.println(lng, 6);
SharedUART.print("http://maps.google.com/?q="); SharedUART.print(lat, 6);
SharedUART.print(","); SharedUART.println(lng, 6);

SharedUART.write(26);
Serial.println("SMS Sent (Latest Data)"); delay(5000);
 
lcd.clear();
}

//	Setup
void setup() { Serial.begin(115200);
pinMode(SOS_PIN, INPUT_PULLUP); pinMode(LED_STATUS, OUTPUT); pinMode(LED_SOS, OUTPUT);

lcd.init(); lcd.backlight();
GPS.begin(9600, SERIAL_8N1, GPS_RX, GPS_TX); SharedUART.begin(9600, SERIAL_8N1, UART1_RX, UART1_TX);

lcd.print("Connecting WiFi"); Serial.println("Connecting WiFi...");

WiFi.begin(ssid, password); showWiFiConnecting();

Serial.println("\nWiFi Connected!"); Serial.println(WiFi.localIP());

lcd.clear();
lcd.print("WiFi Connected"); delay(1000);
}
//	Loop
void loop() {
while (GPS.available()) { gps.encode(GPS.read());
}
float lat = gps.location.isValid() ? gps.location.lat() : 0; float lng = gps.location.isValid() ? gps.location.lng() : 0;
readNanoData();

float temp = nanoTemp;
//   Calculate time left
unsigned long elapsed = millis() - lastUpdate;
unsigned long timeLeft = (elapsed < uploadInterval) ? (uploadInterval - elapsed) / 1000 : 0;
Serial.print("Temp: "); Serial.print(temp); Serial.print(" | HR: "); Serial.print(heartRate); Serial.print(" | SPO2: ");
 
Serial.println(spo2); showNormal(temp, timeLeft);
if (millis() - lastUpdate > uploadInterval) { sendToThingSpeak(temp, lat, lng); lastUpdate = millis();
}

if (digitalRead(SOS_PIN) == LOW) { Serial.println("SOS Button Pressed!"); digitalWrite(LED_SOS, HIGH);
sendSMS(temp, lat, lng); delay(5000);
} else {
digitalWrite(LED_SOS, LOW);
}

delay(1000);
}




